# Supabase Auth
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# App data Postgres
# DATABASE_URL is preferred. POSTGRES_URL, POSTGRES_PRISMA_URL, or
# POSTGRES_URL_NON_POOLING also work as fallbacks in lib/db/client.ts.
DATABASE_URL=
DATABASE_SSL=

# App URLs
# Local dev example: http://localhost:3000
# Production example: https://your-domain.com
NEXT_PUBLIC_SITE_URL=
APP_URL=
NEXT_PUBLIC_VERCEL_URL=

# Hosted AI fallback
OPENROUTER_API_KEY=

# Secret encryption for BYOK provider keys and Google refresh tokens.
# Use a long random string, 32-byte base64 value, or 64-char hex value.
ALIBI_SECRET_ENCRYPTION_KEY=

# Optional Google Calendar sync
# Add this redirect URI to the Google OAuth Web client:
# http://localhost:3000/api/google/calendar/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
ALIBI_OAUTH_STATE_SECRET=

# Optional Cartesia voice chat
CARTESIA_API_KEY=
CARTESIA_DEFAULT_VOICE_ID=
CARTESIA_VERSION=
CARTESIA_TTS_MODEL=
CARTESIA_STT_MODEL=

# Optional demo-only hosted AI overrides
OPENROUTER_DEMO_API_KEY=
OPENROUTER_DEMO_FAST_MODEL=
OPENROUTER_DEMO_COMPANION_MODEL=
ANTHROPIC_DEMO_API_KEY=
ANTHROPIC_API_KEY=

# Optional dev auth redirect override
NEXT_PUBLIC_DEV_SUPABASE_REDIRECT_URL=
